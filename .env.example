# Copy to apps/web/.env.local (git-ignored). Never commit real values.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_SCOPES="account:read posts:read posts:write ideas:read ideas:write offline_access"
# Public origin of this app. Redirect URI registered at Buffer must be APP_URL + /callback
APP_URL=https://localhost:3000
# 32+ random chars: openssl rand -base64 32
SESSION_SECRET=
